# ─── Django Core ────────────────────────────────────────────────────────────
# SECRET_KEY must be a random string for production. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ─── Database (PostgreSQL with PostGIS) ──────────────────────────────────────
# Connection details must match docker-compose.yml services.db
DB_NAME=fastmart
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5434

# ─── Redis (used for Channels, Cache, Celery) ───────────────────────────────
# Three separate Redis DBs: 0 (Channels), 1 (Cache), 2 (Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT Token Lifecycle ────────────────────────────────────────────────────
# How long tokens remain valid before requiring a refresh
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── Razorpay Payment Gateway (Test/Live Keys) ──────────────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
# For testing, use Test Mode keys (no real transactions)
# For production, switch to Live Mode keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret-key
# Webhook secret configured at https://dashboard.razorpay.com → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Web Push Notifications (VAPID Keys) ────────────────────────────────────
# Generate once with: python manage.py generate_vapid_keys
# Public key is sent to browser; private key must NEVER be exposed
VAPID_PRIVATE_KEY=your-private-key
VAPID_PUBLIC_KEY=your-public-key
VAPID_CLAIMS_EMAIL=your-email@example.com

# ─── Business Logic Constants ───────────────────────────────────────────────
# How long to hold stock after order placement before releasing on payment timeout
STOCK_HOLD_MINUTES=10

# Rider assignment — search radius in metres for finding nearby on-duty riders.
RIDER_SEARCH_RADIUS_METRES=50000

# Service radius — max distance in km from store to customer for delivery.
MAX_SERVICE_RADIUS_KM=50000

# Max orders per delivery batch before a new batch is opened for the next rider.
MAX_BATCH_SIZE=4

# Rider batch assignment — waiting times (seconds) before dispatching a partial batch
# Format: comma-separated values e.g. "240,180,120" means try at 4min, then 3min, then 2min
BATCH_WAITING_TIMES_SECONDS=240,180,120

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# ─── Email Configuration (SMTP) ──────────────────────────────────────────────
# For Gmail: enable 2FA, generate App Password, and use it here
# See: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=FastMart <your-email@gmail.com>

# ─── CartoDB (Optional, for admin map basemaps) ──────────────────────────────
# Used by Django admin's GeoDjango map widgets. Get free API key from:
# https://carto.com/basemaps/apikey/
CARTO_API_KEY=your-carto-api-key
