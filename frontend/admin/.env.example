# ─── Backend API Configuration ──────────────────────────────────────────────
# Backend server address for Vite proxy in development
# In production (build), this is NOT used (frontend makes relative requests to /api)
VITE_BACKEND_URL=http://localhost:8000

# ─── Frontend Server Port (Development Only) ────────────────────────────────
# Port on which the Vite dev server runs locally
VITE_PORT=5175
